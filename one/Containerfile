FROM alpine:latest

# Define a build-time argument with a default value
ARG APP_VERSION="1.0.0"

# Define a build-time argument without a default value
ARG BUILD_ENV

# Use the ARG during the build process
RUN echo "Building version: ${APP_VERSION} for environment: ${BUILD_ENV}" > /build-info.txt

# Persist an ARG into the final container by assigning it to an ENV
ENV RUNTIME_VERSION=${APP_VERSION}

# Print the build info and check environment variables when the container runs
CMD ["sh", "-c", "cat /build-info.txt && echo 'RUNTIME_VERSION:' $RUNTIME_VERSION && echo 'BUILD_ENV:' $BUILD_ENV"]
